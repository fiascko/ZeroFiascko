# =========================
# ZeroFiascko - .gitignore
# =========================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains IDEs
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies
node_modules/

# Build / generated files
dist/
build/
coverage/

# Environment / secrets
.env
.env.*
!.env.example

# Temporary files
*.tmp
*.temp
*.cache

# Editor backup / swap files
*~
*.swp
*.swo

# Local project saves
saves/*.json

# Keep the saves directory in Git
!saves/.gitkeep
